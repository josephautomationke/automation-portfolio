    {
      "parameters": {
        "jsCode": "// =========================================\n// ISP Dispatcher V13\n// Normalize + Area Match + Duplicate Check\n// (Skills matching removed — area/availability only)\n// =========================================\n\nconst rawBooking = $('Google Sheets Trigger').first().json;\nconst booking = {};\nfor (const key in rawBooking) {\n    booking[key.trim()] = rawBooking[key];\n}\n\nconst rows = $input.all().map(item => item.json);\n\nconst technicians = [];\nconst schedule = [];\n\nfor (const row of rows) {\n    if (row[\"Jobs Today\"] !== undefined) {\n        technicians.push(row);\n    } else if (row[\"Booking ID\"] !== undefined || row[\"BookingID\"] !== undefined) {\n        schedule.push(row);\n    }\n}\n\n// =========================================\n// Helper Functions\n// =========================================\n\nfunction clean(value) {\n    if (value === undefined || value === null) return \"\";\n    return String(value).trim();\n}\n\nfunction lower(value) {\n    return clean(value).toLowerCase();\n}\n\nfunction normalizeDate(value) {\n    value = clean(value);\n    if (!value) return \"\";\n    if (value.includes(\"/\")) {\n        const p = value.split(\"/\");\n        if (p.length === 3) {\n            const day = p[0].padStart(2, \"0\");\n            const month = p[1].padStart(2, \"0\");\n            const year = p[2];\n            return `${year}-${month}-${day}`;\n        }\n    }\n    if (value.includes(\"-\")) return value.substring(0, 10);\n    return value;\n}\n\nfunction normalizeTime(value) {\n    value = clean(value);\n    if (!value) return \"\";\n    const lowerTime = value.toLowerCase();\n    if (lowerTime.includes(\"am\") || lowerTime.includes(\"pm\")) {\n        const d = new Date(\"1970-01-01 \" + lowerTime);\n        if (!isNaN(d)) return d.toTimeString().substring(0, 5);\n    }\n    return lowerTime.substring(0, 5);\n}\n\nfunction normalizePhone(value) {\n    value = clean(value).replace(/[^0-9]/g, \"\");\n    if (value.startsWith(\"0\")) return \"254\" + value.substring(1);\n    if (value.startsWith(\"254\")) return value;\n    if (value.length === 9) return \"254\" + value;\n    return value;\n}\n\n// =========================================\n// Remove Duplicate Technicians\n// =========================================\n\nconst unique = new Map();\n\nfor (const tech of technicians) {\n    const technician = clean(tech.Technician);\n    if (!technician) continue;\n    const key = technician.toLowerCase();\n    if (!unique.has(key)) {\n        unique.set(key, {\n            Technician: technician,\n            Area: lower(tech.Area),\n            Status: lower(tech.Status),\n            Phone: normalizePhone(tech.Phone),\n            JobsToday: Number(tech[\"Jobs Today\"] || 0)\n        });\n    }\n}\n\nconst cleanTechnicians = [...unique.values()];\n\n// =========================================\n// Clean Schedule\n// =========================================\n\nconst cleanSchedule = schedule.map(job => ({\n    BookingID: clean(job[\"Booking ID\"] || job[\"BookingID\"]),\n    Technician: lower(job.Technician),\n    Date: normalizeDate(job.Date),\n    Time: normalizeTime(job.Time),\n    Customer: lower(job.Customer),\n    Area: lower(job.Area),\n    Status: lower(job.Status)\n}));\n\n// =========================================\n// Booking Object\n// =========================================\n\nconst bookingData = {\n    customer: clean(booking[\"Full Name\"]),\n    phone: normalizePhone(booking[\"Phone Number\"]),\n    email: clean(booking[\"Email Address\"]),\n    area: lower(booking[\"Installation Area\"]),\n    package: clean(booking[\"Internet Package\"]),\n    date: normalizeDate(booking[\"Preferred Installation Date\"]),\n    time: normalizeTime(booking[\"Preferred Time\"])\n};\n\n// =========================================\n// DUPLICATE CUSTOMER BOOKING CHECK\n// Same customer name + date + time, still active\n// =========================================\n\nconst isDuplicateCustomerBooking = cleanSchedule.some(row =>\n    row.Customer === bookingData.customer.toLowerCase() &&\n    row.Date === bookingData.date &&\n    row.Time === bookingData.time &&\n    row.Status !== \"completed\" &&\n    row.Status !== \"cancelled\"\n);\n\n// =========================================\n// TECHNICIAN MATCH\n// - right area\n// - not busy/off\n// - sorted by workload (fairness)\n// - not already booked at this date/time\n// =========================================\n\nlet available = null;\n\nif (!isDuplicateCustomerBooking) {\n    const candidates = cleanTechnicians\n        .filter(tech =>\n            tech.Area === bookingData.area &&\n            tech.Status !== \"busy\" &&\n            tech.Status !== \"off\"\n        )\n        .sort((a, b) => a.JobsToday - b.JobsToday);\n\n    available = candidates.find(tech =>\n        !cleanSchedule.some(row =>\n            row.Technician === tech.Technician.toLowerCase() &&\n            row.Date === bookingData.date &&\n            row.Time === bookingData.time &&\n            row.Status !== \"completed\" &&\n            row.Status !== \"cancelled\"\n        )\n    );\n}\n\n// =========================================\n// Status Logic\n// =========================================\n\nlet status;\nif (isDuplicateCustomerBooking) {\n    status = \"duplicate booking\";\n} else if (available) {\n    status = \"pending\";\n} else {\n    status = \"no technician available\";\n}\n\n// =========================================\n// Output\n// =========================================\n\nreturn [\n    {\n        json: {\n            ...bookingData,\n            bookingId: $('Edit Fields').item.json.bookingId,\n            available: !!available,\n            duplicate: isDuplicateCustomerBooking,\n            technician: available ? available.Technician : \"\",\n            technicianPhone: available ? available.Phone : \"\",\n            jobsToday: available ? available.JobsToday + 1 : 0,\n            status: status,\n            technicianCount: cleanTechnicians.length,\n            scheduleCount: cleanSchedule.length\n        }\n    }\n];"
      },
